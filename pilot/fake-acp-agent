#!/usr/bin/env python3
"""Stand-in for claude-agent-acp when piloting: an ACP agent on stdio (newline-delimited JSON-RPC)
that answers like the adapter does, without the model.

It answers initialize, session/new, session/resume, session/load, session/fork (a new id),
session/close and session/set_mode. A prompt
streams a tool call (pending, then completed) and "reply to: <text>" in two chunks after
$FAKE_AGENT_DELAY seconds, then ends the turn. "run <cmd>" runs a shell command as a tool would,
a child of this process; "slow <n>" works for n seconds; "perm" asks for a permission and replies
with the outcome. "diff" edits src/app.lua (a diff tool call), "term <cmd>" runs a command whose
output streams as terminal output deltas (claude-agent-acp's _meta extension) and ends with its
exit code, "stream <n> [<gap>]" streams n words one chunk at a time (gap or $FAKE_STREAM_GAP seconds apart),
"think" thinks (two chunks) before it answers, "markdown" answers with `code`, **bold** and a heading, and
"plan" sends a plan. session/cancel ends the running turn as cancelled. Tool calls carry the tool's name in
_meta.claudeCode.toolName and its input in rawInput, as claude-agent-acp's do.
"write <path> <text>", "read <path>" and "bash <cmd>" are Write, Read and Bash tool calls that first
run the session's PreToolUse hooks (from _meta.claudeCode.options.settings) as Claude Code does: a
hook that exits 2 blocks the call, its stderr the reason, which the reply then starts "blocked: ".

Sessions are kept on disk ($FAKE_ACP_LOG.sessions/<id>.json: the user's prompts and the agent's
messages, each agent message with the messageId its chunks carry, as claude-agent-acp's do), so a
session outlives the process: session/resume and session/load (which replays it) find it, and
session/fork copies it, up to the agent message _meta.jetbrains.air.fork.messageId names (the
adapter's fork point), into a new one. "history" answers with the session's earlier prompts, so a
check sees what a resumed, forked or rewound session remembers. "ask" asks two questions as a form
elicitation (elicitation/create, as the adapter presents AskUserQuestion) when the client offers
forms, and replies with what came back.

The system prompt is kept as Claude Code 2.1.314 keeps it: session/new stores _meta.systemPrompt.append
as the session's prompt snapshot, and session/resume, session/load and session/fork keep the one the
session (or its source) started with, ignoring the append they're sent. "system" answers with that
snapshot; "whoami" with the role the agent believes it has: the last "[isovim: your role is now X]"
message it was given, else the snapshot's "as a X agent". While $FAKE_AUTH_FILE says false (claude
logged out) every prompt fails at once with "Authentication required", as the adapter's do; "limit"
fails with a usage limit. "bg <cmd>" runs cmd as Claude runs a background Bash: a child of this
process in a process group of its own, still running after the turn.

Every frame it receives goes to $FAKE_ACP_LOG (JSON lines), the first with the env it started
with, so checks can see what the client sent. A prompt that arrives while another is running is
logged as an overlap: the client is meant to queue them. It takes image blocks in a prompt
(promptCapabilities.image), as the adapter does, unless $FAKE_ACP_NO_IMAGE is set."""

import json
import os
import re
import subprocess
import sys
import threading
import time
import uuid

LOG = os.environ.get("FAKE_ACP_LOG")
DELAY = float(os.environ.get("FAKE_AGENT_DELAY", "1"))
GAP = float(os.environ.get("FAKE_STREAM_GAP", "0.2"))
write_lock = threading.Lock()
pending = {}
# Each session's hooks, as the client passed them in _meta.claudeCode.options.settings.
session_hooks = {}
next_id = [1000]
running = {"prompt": None, "cancelled": False}
state_lock = threading.Lock()
client = {"capabilities": {}}
SESSIONS = (LOG + ".sessions") if LOG else None
EXT = ".json"
# FAKE_ACP_CLAUDE_KEYED: sessions are kept as Claude Code keeps them, by the path the agent runs in
# (<CLAUDE_CONFIG_DIR>/projects/<realpath of cwd, every non-alphanumeric as ->/<id>.jsonl), so one
# resumes only where its transcript is under the cwd's key, as with the real adapter.
if os.environ.get("FAKE_ACP_CLAUDE_KEYED"):
    claude_dir = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    SESSIONS = os.path.join(claude_dir, "projects", re.sub(r"[^a-zA-Z0-9]", "-", os.path.realpath(os.getcwd())))
    EXT = ".jsonl"
memory = {}
session_lock = threading.Lock()
turn = {"messageId": None, "text": ""}
background = []


def load_session(sid):
    if not SESSIONS:
        return memory.get(sid)
    path = os.path.join(SESSIONS, sid + EXT)
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return json.load(f)


def save_session(sid, data):
    if not SESSIONS:
        memory[sid] = data
        return
    os.makedirs(SESSIONS, exist_ok=True)
    tmp = os.path.join(SESSIONS, f".{sid}.{os.getpid()}.tmp")
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, os.path.join(SESSIONS, sid + EXT))


def remember(sid, message):
    with session_lock:
        data = load_session(sid) or {"messages": []}
        data["messages"].append(message)
        save_session(sid, data)


def log(entry):
    if LOG:
        with open(LOG, "a") as f:
            f.write(json.dumps(entry) + "\n")


def send(frame):
    with write_lock:
        sys.stdout.write(json.dumps(frame) + "\n")
        sys.stdout.flush()


def update(session, body):
    send({"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": session, "update": body}})


def request(method, params):
    """A request to the client; returns its result (or error) once answered, None when the turn is
    cancelled first (as the adapter gives up on what it asked)."""
    next_id[0] += 1
    rid = next_id[0]
    done = threading.Event()
    pending[rid] = {"event": done}
    send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
    deadline = time.time() + 120
    while not done.wait(0.05) and time.time() < deadline:
        if running["cancelled"]:
            break
    return pending.pop(rid).get("answer")


def text_of(prompt):
    return "".join(block.get("text", "") for block in prompt if block.get("type") == "text")


def chunk(session, text):
    """The agent's text, with the turn's messageId (one agent message a turn)."""
    if turn["messageId"] is None:
        turn["messageId"] = "msg_" + uuid.uuid4().hex[:12]
    turn["text"] += text
    update(session, {"sessionUpdate": "agent_message_chunk", "messageId": turn["messageId"],
                     "content": {"type": "text", "text": text}})


def work(seconds):
    """Sleeps, ending early when the turn is cancelled."""
    deadline = time.time() + seconds
    while time.time() < deadline:
        if running["cancelled"]:
            return False
        time.sleep(0.05)
    return not running["cancelled"]


def tool(session, call_id, title, kind, status, output=None, name=None, raw=None):
    """A tool call's update; name and raw (its input) go where claude-agent-acp puts them."""
    body = {"sessionUpdate": "tool_call" if status == "pending" else "tool_call_update", "toolCallId": call_id,
            "status": status}
    if status == "pending":
        body.update({"title": title, "kind": kind})
    if name:
        body["_meta"] = {"claudeCode": {"toolName": name}}
    if raw is not None:
        body["rawInput"] = raw
    if output is not None:
        body["content"] = [{"type": "content", "content": {"type": "text", "text": output}}]
    update(session, body)


def pre_tool_use(session, name, tool_input):
    """Runs the session's PreToolUse hooks whose matcher matches the tool, as Claude Code does: the
    call as JSON on stdin; exit code 2 blocks it, with stderr as the reason. Returns the reason, or
    None when the call may go ahead."""
    for entry in session_hooks.get(session, {}).get("PreToolUse", []):
        matcher = entry.get("matcher") or ""
        if matcher and not re.fullmatch(f"(?:{matcher})", name):
            continue
        for hook in entry.get("hooks", []):
            payload = {"session_id": session, "hook_event_name": "PreToolUse", "tool_name": name,
                       "tool_input": tool_input, "cwd": os.getcwd()}
            result = subprocess.run(["bash", "-c", hook["command"]], input=json.dumps(payload), capture_output=True,
                                    text=True, timeout=hook.get("timeout") or 60)
            log({"hook": hook["command"], "tool": name, "code": result.returncode, "stderr": result.stderr})
            if result.returncode == 2:
                return result.stderr.strip()
    return None


def guarded(session, call_id, name, kind, title, tool_input, run):
    """A tool call that its PreToolUse hooks may block; run() does it and returns its output."""
    tool(session, call_id, title, kind, "pending", name=name, raw=tool_input)
    reason = pre_tool_use(session, name, tool_input)
    if reason is not None:
        tool(session, call_id, None, None, "failed", reason)
        chunk(session, "blocked: " + reason)
        return
    output = run()
    tool(session, call_id, None, None, "completed", output)
    chunk(session, f"{name.lower()}: {output}")


def absolute(path):
    return path if os.path.isabs(path) else os.path.join(os.getcwd(), path)


def prompt(rid, params):
    session = params["sessionId"]
    text = text_of(params.get("prompt", []))
    with state_lock:
        if running["prompt"] is not None:
            log({"overlap": True, "text": text, "running": running["prompt"]})
        running["prompt"] = text
    call_id = "tool-" + uuid.uuid4().hex[:8]
    stop = "end_turn"
    earlier = [m["text"] for m in (load_session(session) or {"messages": []})["messages"] if m["role"] == "user"]
    remember(session, {"role": "user", "text": text})
    turn["messageId"], turn["text"] = None, ""
    if text == "history":
        chunk(session, "history: " + " | ".join(earlier))
    elif text == "system":
        chunk(session, "system: " + ((load_session(session) or {}).get("system") or ""))
    elif text == "whoami":
        told = [m.group(1) for m in (re.match(r"\[isovim: your role is now ([\w-]+)\]", e) for e in earlier) if m]
        snap = re.search(r"as a ([\w-]+) agent", (load_session(session) or {}).get("system") or "")
        chunk(session, "role: " + (told[-1] if told else snap.group(1) if snap else "unknown"))
    elif text == "ask":
        if (client["capabilities"].get("elicitation") or {}).get("form") is None:
            chunk(session, "no elicitation")
        else:
            tool(session, call_id, "AskUserQuestion", "other", "pending", name="AskUserQuestion",
                 raw={"questions": [{"question": "Which color?", "header": "Color"}, {"question": "Which sizes?", "header": "Sizes"}]})
            answer = request("elicitation/create", {
                "mode": "form", "sessionId": session, "toolCallId": call_id,
                "message": "Please answer the following questions.",
                "requestedSchema": {"type": "object", "properties": {
                    "question_0": {"type": "string", "title": "Color", "description": "Which color?",
                                   "oneOf": [{"const": "Red", "title": "Red"},
                                             {"const": "Blue", "title": "Blue", "description": "the calm one"}]},
                    "question_0_custom": {"type": "string", "title": "Other"},
                    "question_1": {"type": "array", "title": "Sizes", "description": "Which sizes?",
                                   "items": {"anyOf": [{"const": "S", "title": "S"}, {"const": "M", "title": "M"},
                                                       {"const": "L", "title": "L"}]}},
                    "question_1_custom": {"type": "string", "title": "Other"},
                }},
            })
            result = (answer or {}).get("result") or {}
            tool(session, call_id, None, None, "completed" if result.get("action") == "accept" else "failed")
            chunk(session, "answer: " + json.dumps(result, sort_keys=True))
    elif text.startswith("bg "):
        # As Claude runs a run_in_background Bash: its own child, in a process group (session) of
        # its own, left running when the turn ends.
        command = text[3:]
        proc = subprocess.Popen(["bash", "-c", command], start_new_session=True, stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        background.append(proc)
        tool(session, call_id, "run in background " + command, "execute", "pending", name="Bash",
             raw={"command": command, "run_in_background": True})
        tool(session, call_id, None, None, "completed", f"running in background (pid {proc.pid})")
        chunk(session, f"started: {proc.pid}")
    elif text.startswith("run "):
        command = text[4:]
        tool(session, call_id, "run " + command, "execute", "pending", name="Bash", raw={"command": command})
        result = subprocess.run(["bash", "-c", command], capture_output=True, text=True)
        tool(session, call_id, None, None, "completed", (result.stdout + result.stderr).strip())
        chunk(session, "ran: " + command)
    elif text.startswith("write "):
        path, _, content = text[6:].partition(" ")
        path = absolute(path)

        def write():
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(content)
            return "wrote " + path
        guarded(session, call_id, "Write", "edit", "Write " + path, {"file_path": path, "content": content}, write)
    elif text.startswith("read "):
        path = absolute(text[5:])

        def read():
            with open(path) as f:
                return f.read().strip()
        guarded(session, call_id, "Read", "read", "Read " + path, {"file_path": path}, read)
    elif text.startswith("bash "):
        command = text[5:]

        def bash():
            result = subprocess.run(["bash", "-c", command], capture_output=True, text=True)
            return (result.stdout + result.stderr).strip() + f" (exit {result.returncode})"
        guarded(session, call_id, "Bash", "execute", command, {"command": command}, bash)
    elif text == "perm":
        tool(session, call_id, "Bash: rm -rf build", "execute", "pending", name="Bash",
             raw={"command": "rm -rf build", "description": "Remove the build dir"})
        answer = request("session/request_permission", {
            "sessionId": session,
            "toolCall": {"toolCallId": call_id, "title": "Bash: rm -rf build", "kind": "execute"},
            "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"},
                        {"optionId": "reject", "name": "Reject", "kind": "reject_once"}],
        })
        outcome = ((answer or {}).get("result") or {}).get("outcome", {})
        chosen = outcome.get("optionId") or outcome.get("outcome")
        tool(session, call_id, None, None, "failed" if chosen == "reject" else "completed")
        chunk(session, "permission: " + str(chosen))
        if running["cancelled"]:
            stop = "cancelled"
    elif text == "diff":
        path = os.path.join(os.getcwd(), "src", "app.lua")
        old = "local a = 1\nlocal b = 2\nlocal c = 3\nreturn a\n"
        new = "local a = 1\nlocal b = 20\nlocal c = 3\nlocal d = 4\nreturn a\n"
        update(session, {"sessionUpdate": "tool_call", "toolCallId": call_id, "title": "Edit src/app.lua", "kind": "edit",
                         "status": "pending", "locations": [{"path": path}], "_meta": {"claudeCode": {"toolName": "Edit"}},
                         "rawInput": {"file_path": path, "old_string": "local b = 2", "new_string": "local b = 20"}})
        update(session, {"sessionUpdate": "tool_call_update", "toolCallId": call_id, "status": "completed",
                         "locations": [{"path": path, "line": 1}],
                         "content": [{"type": "diff", "path": path, "oldText": old, "newText": new}]})
        chunk(session, "edited src/app.lua")
    elif text.startswith("term "):
        command = text[5:]
        update(session, {"sessionUpdate": "tool_call", "toolCallId": call_id, "title": "`" + command + "`", "kind": "execute",
                         "status": "in_progress", "content": [{"type": "terminal", "terminalId": call_id}],
                         "rawInput": {"command": command},
                         "_meta": {"terminal_info": {"terminal_id": call_id}, "claudeCode": {"toolName": "Bash"}}})
        proc = subprocess.Popen(["bash", "-c", command], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            update(session, {"sessionUpdate": "tool_call_update", "toolCallId": call_id,
                             "_meta": {"terminal_output_delta": {"terminal_id": call_id, "data": line}}})
        code = proc.wait()
        update(session, {"sessionUpdate": "tool_call_update", "toolCallId": call_id,
                         "status": "completed" if code == 0 else "failed",
                         "_meta": {"terminal_exit": {"terminal_id": call_id, "exit_code": code, "signal": None}}})
        chunk(session, "ran it")
    elif text.startswith("stream "):
        args = text.split()[1:]
        gap = float(args[1]) if len(args) > 1 else GAP
        for i in range(int(args[0])):
            if running["cancelled"]:
                stop = "cancelled"
                break
            chunk(session, f"w{i + 1} ")
            time.sleep(gap)
    elif text == "think":
        update(session, {"sessionUpdate": "agent_thought_chunk", "content": {"type": "text", "text": "pondering the question"}})
        update(session, {"sessionUpdate": "agent_thought_chunk", "content": {"type": "text", "text": "\nand then some more"}})
        chunk(session, "thought about it")
    elif text == "markdown":
        chunk(session, "Use `greet` and **bold** here.\n\n## A heading\n- a list item")
    elif text == "plan":
        update(session, {"sessionUpdate": "plan", "entries": [
            {"content": "read the code", "status": "completed", "priority": "high"},
            {"content": "write the fix", "status": "in_progress", "priority": "high"},
            {"content": "test it", "status": "pending", "priority": "medium"}]})
        chunk(session, "planned")
    else:
        seconds = float(text.split()[1]) if text.startswith("slow ") else DELAY
        tool(session, call_id, "Read notes.md", "read", "pending", name="Read",
             raw={"file_path": os.path.join(os.getcwd(), "notes.md")})
        if work(seconds):
            tool(session, call_id, None, None, "completed")
            chunk(session, "reply to: ")
            chunk(session, text)
        else:
            stop = "cancelled"
    if turn["messageId"]:
        remember(session, {"role": "agent", "id": turn["messageId"], "text": turn["text"]})
    with state_lock:
        running["prompt"] = None
    send({"jsonrpc": "2.0", "id": rid, "result": {"stopReason": stop}})


def logged_out():
    """claude isn't logged in, as pilot/fake-auth's $FAKE_AUTH_FILE says."""
    path = os.environ.get("FAKE_AUTH_FILE")
    try:
        return bool(path) and open(path).read().strip() == "false"
    except OSError:
        return False


def system_of(params):
    return ((params.get("_meta") or {}).get("systemPrompt") or {}).get("append") or ""


def remember_hooks(session, params):
    meta = params.get("_meta") or {}
    settings = ((meta.get("claudeCode") or {}).get("options") or {}).get("settings") or {}
    session_hooks[session] = settings.get("hooks") or {}


def handle(frame):
    method, rid, params = frame.get("method"), frame.get("id"), frame.get("params") or {}
    if method is None:
        entry = pending.get(rid)
        if entry:
            entry["answer"] = frame
            entry["event"].set()
        return
    if method == "initialize":
        client["capabilities"] = params.get("clientCapabilities") or {}
        send({"jsonrpc": "2.0", "id": rid, "result": {
            "protocolVersion": 1,
            "agentCapabilities": {"loadSession": True,
                                  "sessionCapabilities": {"resume": {}, "fork": {}, "close": {}, "list": {}},
                                  "promptCapabilities": {"image": not os.environ.get("FAKE_ACP_NO_IMAGE")}},
            "agentInfo": {"name": "fake-acp", "version": "1"},
            "authMethods": [],
        }})
    elif method == "session/new":
        sid = "fake-" + uuid.uuid4().hex[:12]
        remember_hooks(sid, params)
        with session_lock:
            save_session(sid, {"messages": [], "cwd": params.get("cwd"), "system": system_of(params)})
        send({"jsonrpc": "2.0", "id": rid, "result": {"sessionId": sid}})
    elif method == "session/resume":
        if os.environ.get("FAKE_ACP_CLAUDE_KEYED") and load_session(params.get("sessionId")) is None:
            send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32603,
                                                          "message": "No conversation found with session ID: " + str(params.get("sessionId"))}})
            return
        remember_hooks(params.get("sessionId"), params)
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
    elif method == "session/load":
        sid = params["sessionId"]
        remember_hooks(sid, params)
        for message in (load_session(sid) or {"messages": []})["messages"]:
            kind = "user_message_chunk" if message["role"] == "user" else "agent_message_chunk"
            body = {"sessionUpdate": kind, "content": {"type": "text", "text": message["text"]}}
            if message.get("id"):
                body["messageId"] = message["id"]
            update(sid, body)
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
    elif method == "session/fork":
        source = load_session(params["sessionId"]) or {"messages": []}
        point = ((((params.get("_meta") or {}).get("jetbrains") or {}).get("air") or {}).get("fork") or {}).get("messageId")
        messages = source["messages"]
        if point:
            ids = [m.get("id") for m in messages]
            if point not in ids:
                send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32602,
                                                              "message": f"Fork point message {point} was not found"}})
                return
            messages = messages[:ids.index(point) + 1]
        sid = "fork-" + uuid.uuid4().hex[:12]
        remember_hooks(sid, params)
        with session_lock:
            save_session(sid, {"messages": messages, "cwd": params.get("cwd"), "forkedFrom": params["sessionId"],
                               "system": source.get("system")})
        send({"jsonrpc": "2.0", "id": rid, "result": {"sessionId": sid}})
    elif method == "session/close":
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
    elif method == "session/set_mode":
        update(params["sessionId"], {"sessionUpdate": "current_mode_update", "currentModeId": params.get("modeId")})
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
    elif method == "session/prompt" and logged_out():
        # As the adapter answers a prompt when claude isn't logged in: at once, an error.
        log({"failed": "auth", "text": text_of(params.get("prompt", []))})
        send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": "Authentication required"}})
    elif method == "session/prompt" and text_of(params.get("prompt", [])) == "limit":
        send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": "Claude AI usage limit reached"}})
    elif method == "session/prompt":
        # Here, not in its thread: a cancel that comes right after must not be undone by it.
        running["cancelled"] = False
        threading.Thread(target=prompt, args=(rid, params), daemon=True).start()
    elif method == "session/cancel":
        running["cancelled"] = True
    elif rid is not None:
        send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32601, "message": "Method not found"}})


def main():
    keep = ("CLAUDE_CODE_EXECUTABLE", "CLAUDE_CODE_ENTRYPOINT", "ISOVIM_ADDR", "ISOVIM_ACP", "PWD")
    log({"started": True, "pid": os.getpid(), "cwd": os.getcwd(), "env": {k: os.environ.get(k) for k in keep}})
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        frame = json.loads(line)
        log({"frame": frame})
        handle(frame)


main()
