#!/usr/bin/env bash
# Stand-in for `claude auth status` and `codex login status` when piloting (ISOVIM_AUTH_CLAUDE and
# ISOVIM_AUTH_CODEX point here): logged in unless $FAKE_AUTH_FILE says false. Each call is logged
# to $FAKE_AUTH_FILE.log.
[ -n "$FAKE_AUTH_FILE" ] && echo "$*" >>"$FAKE_AUTH_FILE.log"
state=true
[ -n "$FAKE_AUTH_FILE" ] && [ "$(cat "$FAKE_AUTH_FILE" 2>/dev/null)" = false ] && state=false
case "$1 $2" in
"auth status")
  if [ "$state" = true ]; then
    echo '{"loggedIn": true, "authMethod": "claude.ai"}'
  else
    echo '{"loggedIn": false, "authMethod": "none"}'
    exit 1
  fi
  ;;
"login status")
  if [ "$state" = true ]; then
    echo "Logged in using ChatGPT"
  else
    echo "Not logged in"
    exit 1
  fi
  ;;
*)
  echo "fake-auth: only auth status and login status" >&2
  exit 2
  ;;
esac
