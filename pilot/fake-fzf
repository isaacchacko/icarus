#!/usr/bin/env bash
# Stand-in for an interactive fzf when piloting `iso jump`: each run takes the next pick from the
# file $FAKE_FZF_PICKS (one a line) and prints the row whose first field (its id) is that pick, else
# the first row `fzf --filter` keeps for it. A pick of ESC, or none left, cancels as Esc would.
# Its arguments are appended to $FAKE_FZF_LOG, if set.
[ -n "${FAKE_FZF_LOG:-}" ] && printf '%s\n' "$*" >>"$FAKE_FZF_LOG"
rows="$(cat)"
pick="$(head -n 1 "$FAKE_FZF_PICKS" 2>/dev/null)"
[ -s "$FAKE_FZF_PICKS" ] || exit 130
sed -i.bak 1d "$FAKE_FZF_PICKS" && rm -f "$FAKE_FZF_PICKS.bak"
[ "$pick" = ESC ] && exit 130
line="$(printf '%s\n' "$rows" | awk -F '\t' -v p="$pick" '$1 == p { print; exit }')"
[ -n "$line" ] || line="$(printf '%s\n' "$rows" | fzf --delimiter '\t' --with-nth '3..' --filter "$pick" | head -n 1)"
[ -n "$line" ] || exit 1
printf '%s\n' "$line"
