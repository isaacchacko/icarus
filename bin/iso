#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
home="${ISOVIM_HOME:-$HOME/.isovim}"
lock="$home/isovim.lock"
cli="$repo/lua/isovim/cli.lua"
# A non-interactive ssh (iso move's other end) gets a bare PATH; on macOS that misses Homebrew.
PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"

# iso move streams a workspace in as a tar; unpack it next to the workspaces so it can be renamed in.
if [ "${1:-}" = receive ]; then
  mkdir -p "$home/workspaces"
  incoming="$(mktemp -d "$home/incoming.XXXXXX")"
  # A copy that fails partway leaves nothing here; the sender keeps what it sent.
  if ! tar -xf - -C "$incoming"; then
    rm -rf "$incoming"
    echo "iso receive: the copy here failed; nothing of it is kept" >&2
    exit 1
  fi
  NVIM_APPNAME=isovim exec nvim -l "$cli" receive "$incoming"
fi

case "${1:-}" in
browser)
  NVIM_APPNAME=isovim nvim -l "$cli" __warn "$@" || exit 1
  shift
  exec node "$repo/bin/iso-browser.mjs" "$@"
  ;;
worker | router | repo-root | root)
  # iso <role> browser: the same browser, after the role check.
  if [ "${2:-}" = browser ]; then
    NVIM_APPNAME=isovim nvim -l "$cli" __warn "$@" || exit 1
    shift 2
    exec node "$repo/bin/iso-browser.mjs" "$@"
  fi
  ;;
-h | --help)
  NVIM_APPNAME=isovim exec nvim -l "$cli" "$@"
  ;;
esac

# A command is a word with an entry in the command table; any other argument opens the TUI on it.
if [[ "${1:-}" =~ ^[a-z_][a-z0-9_-]*$ ]] && grep -qF "{ name = \"$1\"," "$repo/lua/isovim/cli/commands.lua"; then
  NVIM_APPNAME=isovim exec nvim -l "$cli" "$@"
fi

takeover=""
if [ "${1:-}" = "--takeover" ]; then
  takeover=1
  shift
fi

mkdir -p "$home/workspaces" "$home/archive"
# The app is the starter config under its own NVIM_APPNAME, so your own nvim is never touched.
config="${XDG_CONFIG_HOME:-$HOME/.config}/isovim"
[ -e "$config" ] || ln -s "$repo/starter" "$config"

# Puts the plugins at lazy-lock.json's commits, on a host's first run and after an update changes
# the lockfile. Lazy installs missing plugins at their newest and rewrites the lockfile as it starts,
# so the lockfile is put back and restored again; parallel clones sometimes fail, so it retries until
# every locked plugin is there.
plugins="${XDG_DATA_HOME:-$HOME/.local/share}/isovim/lazy"
lockfile="$repo/starter/lazy-lock.json"
installed() { find "$plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '; }
locked() { grep -c '"commit"' "$lockfile"; }
restore_plugins() {
  cp "$lockfile" "$lockfile.restore"
  for _ in 1 2 3; do
    NVIM_APPNAME=isovim nvim --headless "+Lazy! restore" +qa >/dev/null 2>&1 || true
    cp "$lockfile.restore" "$lockfile"
    [ "$(installed)" -ge "$(locked)" ] && break
  done
  rm "$lockfile.restore"
  NVIM_APPNAME=isovim nvim --headless "+Lazy! restore" +qa >/dev/null 2>&1 || true
}
if [ "$(installed)" -lt "$(locked)" ]; then
  echo "isovim: installing plugins (first run)..." >&2
  restore_plugins
fi

if [ -f "$lock" ]; then
  pid="$(cat "$lock")"
  # This script names itself in the lock until the TUI starts; a restart runs it again in the same pid.
  if [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null; then
    if [ -z "$takeover" ]; then
      echo "isovim is already open (pid $pid). Run 'iso --takeover' to close it and open here." >&2
      exit 1
    fi
    # The TUI's nvim server (its child) can outlive it by a moment, and an nvim that exits removes
    # its socket's path, by then the new TUI's: so the takeover waits for the server too, and kills
    # it if it hangs on (SIGKILL removes nothing).
    servers="$(pgrep -P "$pid" 2>/dev/null || true)"
    kill -TERM "$pid"
    for _ in $(seq 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "isovim (pid $pid) did not quit." >&2
      exit 1
    fi
    for server in $servers; do
      for _ in $(seq 30); do
        kill -0 "$server" 2>/dev/null || break
        sleep 0.1
      done
      kill -KILL "$server" 2>/dev/null || true
    done
  fi
fi

# A TUI's nvim server whose TUI is gone (one stuck at a prompt when its terminal closed outlived
# it, under launchd) still holds the socket and its swap files, and would remove the socket's path
# as it exited, by then the new TUI's. It ends itself (isovim.orphan) unless it's wedged; if it's
# still here, it's killed, with SIGKILL, which removes nothing. Only an orphaned nvim --embed: the
# pid may since be another process's.
server_file="$home/isovim.server"
if [ -f "$server_file" ]; then
  server="$(head -n1 "$server_file")"
  if [ -n "$server" ] && [ "$(ps -o ppid= -p "$server" 2>/dev/null | tr -d ' ')" = 1 ] &&
    ps -o command= -p "$server" 2>/dev/null | grep -q 'nvim.*--embed'; then
    echo "isovim: ending the last TUI's server (pid $server), left behind when its TUI went" >&2
    kill -KILL "$server" 2>/dev/null || true
    for _ in $(seq 30); do
      kill -0 "$server" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$server_file"
fi

# No live isovim holds the socket now; a crashed one may have left it behind.
rm -f "${ISOVIM_SOCK:-$home/nvim.sock}"

# The TUI names itself in the lock as it starts (store.take_lock). It exits with 75 to restart onto
# an update (isovim.update): the plugins go to the lockfile's commits if it changed, and this script
# runs again from the top, as the updated bin/iso, with no arguments; the TUI opens what was open.
# One block, so a pull that rewrites this file while the TUI runs can't change what's left of it.
echo $$ >"$lock"
{
  before="$(cksum <"$lockfile")"
  code=0
  ISOVIM_LOOP=1 NVIM_APPNAME=isovim nvim "$@" || code=$?
  [ "$code" = 75 ] || exit "$code"
  if [ "$(cksum <"$lockfile")" != "$before" ]; then
    echo "isovim: restoring plugins to the updated lazy-lock.json..." >&2
    restore_plugins
  fi
  exec "$repo/bin/iso"
}
