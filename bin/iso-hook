#!/usr/bin/env bash
# Hooks for an agent (wired in panes.lua): record its state in $ISOVIM_STATE for the sidebar, and
# raise a desktop notification while the isovim TUI is closed, unless the agent is hidden. Each
# change of state is also published on isovim's event bus (isovim.events).
# `iso-hook desktop <message>` only notifies; the TUI uses it when it isn't focused.

desktop() {
  # Pilots read notifications from a log instead of the screen.
  if [ -n "$ISOVIM_NOTIFY_LOG" ]; then
    echo "$1" >>"$ISOVIM_NOTIFY_LOG"
    return
  fi
  if command -v osascript >/dev/null; then
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "isovim"' -e 'end run' "$1" >/dev/null 2>&1 &
  elif command -v notify-send >/dev/null; then
    notify-send isovim "$1" &
  fi
}

# The agent as events and iso name it, <ws>/<agent> by ids: $ISOVIM_ADDR, or for an agent started
# before isovim set it, from its state file run/<ws>/<agent>.state.
address() {
  if [ -n "$ISOVIM_ADDR" ]; then
    printf %s "$ISOVIM_ADDR"
    return
  fi
  local file="${ISOVIM_STATE%.state}" dir="${ISOVIM_STATE%/*}"
  printf %s "${dir##*/}/${file##*/}"
}

# One event on isovim's bus, as isovim.events writes them: a JSON line {topic, time, ...} appended in
# one write to <ISOVIM_HOME>/events/events.jsonl, which moves to events.jsonl.1 past 1 MiB.
# $2 is the details, already JSON: "key":value,...
publish() {
  local dir="${ISOVIM_STATE%/*/*/*}/events" now="${EPOCHREALTIME:-$(date +%s)}"
  local log="$dir/events.jsonl"
  [ -d "$dir" ] || mkdir -p "$dir"
  [ -n "$(find "$log" -size +2048 2>/dev/null)" ] && mv -f "$log" "$log.1"
  printf '{"topic":"%s","time":%s,%s}\n' "$1" "${now/,/.}" "$2" >>"$log"
}

# One part of a topic as isovim.events.encode writes it: "%" as %25, then "." as %2E.
encode() {
  local value="${1//\%/%25}"
  printf %s "${value//./%2E}"
}

# Every state the hooks write goes through here; a change is published as
# agent.<scope>.<id>.status, the address split at its last "/" (a scope may hold one, an id never),
# each part encoded in the topic and raw in the details.
set_state() {
  # An ACP agent's supervisor (isovim.acp.host) owns its state; its hooks do only the rest.
  [ -n "$ISOVIM_ACP" ] && return
  local previous="" addr scope id
  IFS= read -r previous 2>/dev/null <"$ISOVIM_STATE"
  # A second line is why, when it matters (isovim.status.reason).
  printf %s "$1${2:+
$2}" >"$ISOVIM_STATE"
  [ "$previous" = "$1" ] && return
  [ -n "$previous" ] && previous="\"$previous\"" || previous=null
  addr="$(address)"
  scope="${addr%/*}" id="${addr##*/}"
  publish "agent.$(encode "$scope").$(encode "$id").status" \
    "\"addr\":\"$addr\",\"scope\":\"$scope\",\"id\":\"$id\",\"state\":\"$1\",\"previous\":$previous"
}

# The open TUI notifies on its own, knowing whether the chat is on screen.
notify() {
  [ -S "$ISOVIM_SOCK" ] || [ -n "$ISOVIM_HIDDEN" ] && return
  meta="${ISOVIM_META:-$PWD/.isovim.json}"
  # Current names (it may have been renamed since it started). $ISOVIM_META is a workspace's
  # .isovim.json, its agents listed in it by id (its state file's name), or a new-layout agent's own
  # record, which has a kind, in a repo named by $ISOVIM_WS.
  id="$(basename "${ISOVIM_STATE%.state}")"
  name="$(jq -r --arg ws "$ISOVIM_WS" 'if has("kind") then $ws else .name // empty end' "$meta" 2>/dev/null)"
  agent="$(jq -r --arg id "$id" 'if has("kind") then .name else (.agents // [])[] | select(.id == $id) | .name end' "$meta" 2>/dev/null)"
  desktop "${name:-isovim} · ${agent:-${ISOVIM_AGENT:-isovim}} $1"
}

# Rewrites the agent's plain-text transcript (workspace/transcripts/<agent>.txt) in the background;
# after an answer, also pins the files and folders it named and registers the PRs it opened
# (iso autopin, iso autopr).
transcript() {
  addr="$(address)"
  iso="$(dirname "$0")/iso"
  if [ "$1" = answered ]; then
    ("$iso" transcript "$addr" && "$iso" autopin "$addr" && "$iso" autopr "$addr") </dev/null >/dev/null 2>&1 &
  else
    ("$iso" transcript "$addr" </dev/null >/dev/null 2>&1 &)
  fi
}

case "$1" in
desktop) desktop "$2" ;;
start)
  set_state ready
  # Claude and Codex both pass the conversation's id; panes.lua resumes it on restart.
  id="$(jq -r '.session_id // empty' 2>/dev/null)"
  [ -n "$id" ] && printf %s "$id" >"${ISOVIM_STATE%.state}.session"
  ;;
prompt)
  set_state working
  transcript
  # A stamp in the prompt is checked against isovim's ledger; what's printed here reaches the agent as
  # context it can tell apart from typed text.
  input="$(cat)"
  case "$input" in
  *"from "* | *"[isovim: your role is now "*)
    printf %s "$input" | "$(dirname "$0")/iso" checkstamp "$(address)"
    ;;
  esac
  ;;
stop)
  # Unread means progress to report, not just a finished turn: until the answer is read, the agent
  # stays "checking" (drawn as working); an answer that only waits on something it started (a build,
  # a server coming up) becomes "waiting" and never notifies.
  set_state checking
  addr="$(address)"
  iso="$(dirname "$0")/iso"
  # An ACP agent has no dialog in a pane to look for, and its supervisor sets its state.
  if [ -n "$ISOVIM_ACP" ]; then
    (
      "$iso" transcript "$addr"
      notify "finished"
      "$iso" autopin "$addr"
      "$iso" autopr "$addr"
    ) </dev/null >/dev/null 2>&1 &
    exit 0
  fi
  (
    # A turn can end on a dialog that waits for you (a plan to approve): it draws just after this
    # hook, so look at the pane a moment later.
    sleep 1.5
    if [ -n "$TMUX_PANE" ] && tmux capture-pane -p -t "$TMUX_PANE" 2>/dev/null | grep -qE "Would you like to proceed\?|Do you want to proceed\?"; then
      set_state attention
      notify "needs you"
    else
      "$iso" transcript "$addr"
      if [ "$("$iso" progress "$addr")" = waiting ]; then
        set_state waiting
      else
        set_state idle
        notify "finished"
      fi
    fi
    "$iso" autopin "$addr"
    "$iso" autopr "$addr"
  ) </dev/null >/dev/null 2>&1 &
  ;;
ask)
  # Nothing waits on you in an ACP agent yet: what it asks is denied (isovim.acp.host).
  [ -n "$ISOVIM_ACP" ] && exit 0
  set_state attention
  notify "needs you"
  ;;
edit | bash)
  # A new-layout agent's first edit makes its worktree, and a read-only agent's edits (and git
  # commands that would change the base clone) are refused: exit 2 blocks the tool call, with what
  # iso printed as the reason. Any agent's edit in a clone of a repo isovim knows, outside its own
  # worktree, is refused. A Bash call is looked at only when it names git: a mutating git command
  # in such a clone is refused too (other shell writes get through, as v0 accepts).
  [ -z "$ISOVIM_ADDR" ] && exit 0
  input="$(cat)"
  if [ "$1" = bash ]; then
    case "$input" in
    *git*) ;;
    *) exit 0 ;;
    esac
  fi
  printf %s "$input" | "$(dirname "$0")/iso" __pretool "$1"
  exit $?
  ;;
interrupt) set_state idle ;;
tool-done)
  grep -qE "attention|waiting" "$ISOVIM_STATE" 2>/dev/null && set_state working
  # A push may have moved isovim's own origin: the open TUI looks now rather than within the minute
  # (isovim.update).
  case "$(cat)" in
  *'"Bash"'*git*push*) ("$(dirname "$0")/iso" update </dev/null >/dev/null 2>&1 &) ;;
  esac
  ;;
notification)
  [ -n "$ISOVIM_ACP" ] && exit 0
  case "$(cat)" in
  *idle_prompt* | *"waiting for your input"*) ;;
  *permission*)
    set_state attention permission
    notify "needs you"
    ;;
  *)
    set_state attention
    notify "needs you"
    ;;
  esac
  ;;
esac
exit 0
